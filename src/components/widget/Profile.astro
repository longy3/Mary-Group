---
import { Icon } from "astro-icon/components";
import { profileConfig, siteConfig } from "../../config";
import { url } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";

const config = profileConfig;
---
<div class="card-base p-3">
    <a aria-label={siteConfig.lang === "zh_CN" ? "关于作者" : "About the author"} href={url('/about/')}
       class="group block relative mx-auto mt-1 lg:mx-0 lg:mt-0 mb-3
       max-w-[12rem] lg:max-w-none overflow-hidden rounded-xl active:scale-95">
        <div class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
        w-full h-full z-50 flex items-center justify-center">
            <Icon name="fa6-regular:address-card"
                  class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-5xl">
            </Icon>
        </div>
        {config.avatar
            ? <ImageWrapper src={config.avatar} alt={config.name} class="mx-auto w-full aspect-square" />
            : <div aria-hidden="true" class="literary-avatar"><span>{Array.from(config.name)[0]}</span></div>}
    </a>
    <div class="px-2">
        <div class="literary-title font-bold text-xl text-center mb-1 dark:text-neutral-50 transition">{config.name}</div>
        <div class="h-1 w-5 bg-[var(--primary)] mx-auto rounded-full mb-2 transition"></div>
        {config.bio && <div class="text-center text-75 mb-2.5 transition">{config.bio}</div>}
        {config.links.length > 0 && <div class="flex flex-wrap gap-2 justify-center mb-1">
            {config.links.map(item => item.url
                ? <a rel="me noopener" aria-label={item.name} title={item.name} href={item.url} target="_blank" class="btn-regular rounded-lg h-10 w-10 active:scale-95"><Icon name={item.icon} class="text-xl" /></a>
                : <span role="img" aria-label={item.name + "（尚未设置）"} title={item.name + "（尚未设置）"} class="inline-flex items-center justify-center rounded-lg h-10 w-10 bg-[var(--btn-regular-bg)] text-[var(--btn-content)]"><Icon name={item.icon} class="text-xl" /></span>)}
        </div>}
    </div>
</div>

