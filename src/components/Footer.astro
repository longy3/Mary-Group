---
import { profileConfig, siteConfig } from "../config";
import { url } from "../utils/url-utils";

const currentYear = new Date().getFullYear();
const chinese = siteConfig.lang === "zh_CN";
---
<div class="border-t border-[var(--line-divider)] mx-8 md:mx-24 mt-10 mb-8 pt-6 text-50 text-sm text-center">
    <div>
        &copy; {currentYear} {profileConfig.name}
        {Astro.site && <> · <a class="link text-[var(--primary)]" href={url("rss.xml")}>RSS</a>
         · <a class="link text-[var(--primary)]" href={url("sitemap-index.xml")}>{chinese ? "站点地图" : "Sitemap"}</a></>}
    </div>
    <div class="mt-1">
        {chinese ? "站点基于" : "Powered by"}
        <a class="link" href="https://astro.build">Astro</a> ·
        <a class="link" href="https://github.com/saicaca/fuwari">Fuwari</a>
    </div>
</div>
